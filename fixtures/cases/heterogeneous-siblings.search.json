{
  "cases": [
    {
      "query": "count",
      "options": { "caseSensitive": false, "wholeWord": false, "regex": false },
      "scope": "document",
      "target": "all",
      "expected": [
        {
          "path": "0/2",
          "target": "text",
          "attr": null,
          "ranges": [[0, 5]]
        },
        {
          "path": "0/5",
          "target": "text",
          "attr": null,
          "ranges": [[2, 7]]
        }
      ]
    },
    {
      "query": "A",
      "options": { "caseSensitive": false, "wholeWord": false, "regex": false },
      "scope": "grid",
      "target": "all",
      "grid": { "path": "0", "group": "item" },
      "expected": [
        {
          "row": 0,
          "column": "@sku",
          "ranges": [[0, 1]]
        },
        {
          "row": 1,
          "column": "name",
          "ranges": [[1, 2]]
        }
      ]
    },
    {
      "query": "true",
      "options": { "caseSensitive": false, "wholeWord": false, "regex": false },
      "scope": "document",
      "target": "attrValues",
      "expected": [
        {
          "path": "0/1",
          "target": "attrValue",
          "attr": "discontinued",
          "ranges": [[0, 4]]
        }
      ]
    }
  ],
  "xpath": [
    {
      "expr": "//item[not(@sku)]",
      "expected": {
        "nodes": [{ "path": "0/3", "kind": "element", "attr": null }]
      }
    },
    {
      "expr": "//note[2]",
      "expected": {
        "nodes": [{ "path": "0/5", "kind": "element", "attr": null }]
      }
    }
  ]
}
