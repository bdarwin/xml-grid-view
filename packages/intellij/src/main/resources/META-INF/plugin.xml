<idea-plugin>
  <id>io.github.bdarwin.xmlgridview</id>
  <name>XML Grid View</name>
  <vendor url="https://github.com/bdarwin/xml-grid-view">Darwin Baisa</vendor>
  <!-- description and change notes are injected by Gradle (patchPluginXml) -->

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.xml</depends>

  <extensions defaultExtensionNs="com.intellij">
    <fileEditorProvider id="xmlGridView.grid" implementation="dev.xmlgridview.intellij.editor.XmlGridEditorProvider"/>
    <fileEditorProvider id="xmlGridView.flat" order="after xmlGridView.grid"
                        implementation="dev.xmlgridview.intellij.editor.XmlFlatEditorProvider"/>
  </extensions>
</idea-plugin>
