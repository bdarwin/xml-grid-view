{
  "name": "xml-grid-view",
  "displayName": "XML Grid View",
  "description": "View and edit XML as a tree, grid or flat sheet, with search, XPath and a JSON-aware value inspector.",
  "version": "0.2.1",
  "publisher": "bdarwin",
  "author": {
    "name": "Darwin Baisa"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1E5AA8",
    "theme": "dark"
  },
  "homepage": "https://github.com/bdarwin/xml-grid-view#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/bdarwin/xml-grid-view.git"
  },
  "bugs": {
    "url": "https://github.com/bdarwin/xml-grid-view/issues"
  },
  "qna": false,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "xml",
    "grid",
    "table",
    "xpath",
    "viewer"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "xmlGridView.editor",
        "displayName": "XML Grid View",
        "selector": [
          {
            "filenamePattern": "*.xml"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "xmlGridView.openWith",
        "title": "Open With XML Grid View",
        "category": "XML Grid View",
        "icon": "$(table)"
      },
      {
        "command": "xmlGridView.showSource",
        "title": "Show Source",
        "category": "XML Grid View",
        "icon": "$(go-to-file)"
      },
      {
        "command": "xmlGridView.find",
        "title": "Find",
        "category": "XML Grid View"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "xmlGridView.openWith",
          "when": "resourceExtname == .xml && activeEditor == workbench.editors.files.textFileEditor",
          "group": "navigation"
        },
        {
          "command": "xmlGridView.showSource",
          "when": "activeCustomEditorId == xmlGridView.editor",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "xmlGridView.openWith",
          "when": "resourceExtname == .xml",
          "group": "navigation@20"
        }
      ],
      "commandPalette": [
        {
          "command": "xmlGridView.openWith",
          "when": "resourceExtname == .xml"
        },
        {
          "command": "xmlGridView.showSource",
          "when": "activeCustomEditorId == xmlGridView.editor"
        },
        {
          "command": "xmlGridView.find",
          "when": "activeCustomEditorId == xmlGridView.editor"
        }
      ]
    },
    "keybindings": [
      {
        "command": "xmlGridView.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId == xmlGridView.editor"
      }
    ],
    "configuration": {
      "title": "XML Grid View",
      "properties": {
        "xmlGridView.copyWithHeader": {
          "type": "boolean",
          "default": false,
          "description": "Include the column header row when copying cells. Ctrl/Cmd+Shift+C does the opposite."
        },
        "xmlGridView.largeFileThresholdMB": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "description": "Files larger than this (in MB) show a notice and are only parsed after clicking \"Load anyway\"."
        },
        "xmlGridView.readOnly": {
          "type": "boolean",
          "default": false,
          "description": "Disable value editing in XML Grid View (the view never changes the document)."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs && vsce package --no-dependencies",
    "compile": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node build.mjs && tsc -p tsconfig.test.json && node out/test/runTest.js",
    "publish:vsce": "vsce publish --no-dependencies --packagePath xml-grid-view-$npm_package_version.vsix",
    "publish:ovsx": "ovsx publish xml-grid-view-$npm_package_version.vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.0",
    "@xmlgridview/core": "workspace:*",
    "@xmlgridview/webview": "workspace:*",
    "esbuild": "^0.25.0",
    "mocha": "^10.7.0",
    "ovsx": "^0.10.0"
  }
}
