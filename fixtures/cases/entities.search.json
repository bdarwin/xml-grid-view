{
  "cases": [
    {
      "query": "<tag>",
      "options": { "caseSensitive": false, "wholeWord": false, "regex": false },
      "scope": "document",
      "target": "all",
      "expected": [
        {
          "path": "0/1",
          "target": "text",
          "attr": null,
          "ranges": [[0, 5]]
        }
      ]
    },
    {
      "query": "\"x\"",
      "options": { "caseSensitive": false, "wholeWord": false, "regex": false },
      "scope": "document",
      "target": "all",
      "expected": [
        {
          "path": "0/2",
          "target": "attrValue",
          "attr": "q",
          "ranges": [[0, 3]]
        }
      ]
    },
    {
      "query": "😀",
      "options": { "caseSensitive": false, "wholeWord": false, "regex": false },
      "scope": "document",
      "target": "all",
      "expected": [
        {
          "path": "0/3",
          "target": "text",
          "attr": null,
          "ranges": [[2, 4]]
        },
        {
          "path": "0/4",
          "target": "text",
          "attr": null,
          "ranges": [[0, 2]]
        }
      ]
    },
    {
      "query": "smile",
      "options": { "caseSensitive": false, "wholeWord": true, "regex": false },
      "scope": "document",
      "target": "all",
      "expected": [
        {
          "path": "0/4",
          "target": "text",
          "attr": null,
          "ranges": [[3, 8]]
        }
      ]
    },
    {
      "query": "AB",
      "options": { "caseSensitive": true, "wholeWord": false, "regex": false },
      "scope": "document",
      "target": "all",
      "expected": [
        {
          "path": "0/3",
          "target": "text",
          "attr": null,
          "ranges": [[0, 2]]
        }
      ]
    }
  ],
  "xpath": [
    {
      "expr": "//c[@name='amp']",
      "expected": {
        "nodes": [{ "path": "0/0", "kind": "element", "attr": null }]
      }
    },
    {
      "expr": "//c[contains(., '<')]/@name",
      "expected": {
        "nodes": [{ "path": "0/1", "kind": "attribute", "attr": "name" }]
      }
    }
  ]
}
