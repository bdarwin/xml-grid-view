          "path": "0",
          "target": "name",
          "attr": null,
          "ranges": [[0, 3]]
        },
        {
          "path": "0/0/0",
          "target": "text",
          "attr": null,
          "ranges": [[4, 7]]
        },
        {
          "path": "0/2/0",
          "target": "text",
          "attr": null,
          "ranges": [[3, 6]]
        },
        {
          "path": "0/2/1",
          "target": "text",
          "attr": null,
          "ranges": [[0, 3]]
        }
      ]
    },
