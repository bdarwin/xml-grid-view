  ],
  "xpath": [
    {
      "expr": "//book[@lang='fr']/title",
      "expected": {
        "nodes": [{ "path": "0/1/0", "kind": "element", "attr": null }]
      }
    },
    {
      "expr": "//@id",
      "expected": {
        "nodes": [{ "path": "0/0", "kind": "attribute", "attr": "id" }, { "path": "0/1", "kind": "attribute", "attr": "id" }, { "path": "0/2", "kind": "attribute", "attr": "id" }]
      }
    },
    {
      "expr": "//book/title/text()",
      "expected": {
        "nodes": [{ "path": "0/0/0", "kind": "text", "attr": null }, { "path": "0/1/0", "kind": "text", "attr": null }, { "path": "0/2/0", "kind": "text", "attr": null }]
      }
    },
    {
      "expr": "count(//book)",
      "expected": { "scalar": 3 }
    },
    {
      "expr": "string(//book[2]/author)",
      "expected": { "scalar": "Saint-Exupéry" }
    },
    {
      "expr": "//book[price > 10]",
      "expected": {
        "nodes": [{ "path": "0/1", "kind": "element", "attr": null }, { "path": "0/2", "kind": "element", "attr": null }]
      }
    },
    {
      "expr": "boolean(//magazine)",
      "expected": { "scalar": false }
    },
    {
      "expr": "//book[",
      "expected": { "error": true }
    },
    {
      "expr": "/catalog/*[last()]",
      "expected": {
        "nodes": [{ "path": "0/2", "kind": "element", "attr": null }]
      }
    }
  ]
}
