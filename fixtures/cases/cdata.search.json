{
  "cases": [
    {
      "query": "a < b",
      "options": { "caseSensitive": false, "wholeWord": false, "regex": false },
      "scope": "document",
      "target": "all",
      "expected": [
        {
          "path": "0/0",
          "target": "text",
          "attr": null,
          "ranges": [[4, 9]]
        }
      ]
    },
    {
      "query": "WHERE",
      "options": { "caseSensitive": false, "wholeWord": false, "regex": false },
      "scope": "document",
      "target": "all",
      "expected": [
        {
          "path": "0/1",
          "target": "text",
          "attr": null,
          "ranges": [[9, 14]]
        }
      ]
    },
    {
      "query": "<",
      "options": { "caseSensitive": false, "wholeWord": false, "regex": false },
      "scope": "grid",
      "target": "all",
      "grid": { "path": "0", "group": "script" },
      "expected": [
        {
          "row": 0,
          "column": "#text",
          "ranges": [[6, 7]]
        },
        {
          "row": 1,
          "column": "#text",
          "ranges": [[17, 18]]
        }
      ]
    }
  ],
  "xpath": [
    {
      "expr": "//script[contains(., '<')]/@lang",
      "expected": {
        "nodes": [{ "path": "0/0", "kind": "attribute", "attr": "lang" }, { "path": "0/1", "kind": "attribute", "attr": "lang" }]
      }
    }
  ]
}
