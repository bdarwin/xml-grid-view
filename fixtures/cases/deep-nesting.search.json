{
  "cases": [
    {
      "query": "deep",
      "options": { "caseSensitive": false, "wholeWord": false, "regex": false },
      "scope": "document",
      "target": "all",
      "expected": [
        {
          "path": "0/0/0/0/0",
          "target": "text",
          "attr": null,
          "ranges": [[0, 4]]
        },
        {
          "path": "0/0/0/0/1",
          "target": "text",
          "attr": null,
          "ranges": [[0, 4]]
        }
      ]
    },
    {
      "query": "deep",
      "options": { "caseSensitive": false, "wholeWord": true, "regex": false },
      "scope": "document",
      "target": "all",
      "expected": [
        {
          "path": "0/0/0/0/0",
          "target": "text",
          "attr": null,
          "ranges": [[0, 4]]
        }
      ]
    },
    {
      "query": "deep",
      "options": { "caseSensitive": false, "wholeWord": false, "regex": false },
      "scope": "grid",
      "target": "all",
      "grid": { "path": "0/0/0/0", "group": "e" },
      "expected": [
        {
          "row": 0,
          "column": "#text",
          "ranges": [[0, 4]]
        },
        {
          "row": 1,
          "column": "#text",
          "ranges": [[0, 4]]
        }
      ]
    }
  ],
  "xpath": [
    {
      "expr": "//e[2]",
      "expected": {
        "nodes": [{ "path": "0/0/0/0/1", "kind": "element", "attr": null }]
      }
    },
    {
      "expr": "/a/b[2]",
      "expected": {
        "nodes": [{ "path": "0/1", "kind": "element", "attr": null }]
      }
    },
    {
      "expr": "//d/ancestor::b",
      "expected": {
        "nodes": [{ "path": "0/0", "kind": "element", "attr": null }]
      }
    }
  ]
}
