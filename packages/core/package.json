{
  "name": "@xmlgridview/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "fixtures:generate": "tsx scripts/generate-fixtures.ts",
    "fixtures:check": "tsx scripts/generate-fixtures.ts --check"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.8",
    "saxes": "^6.0.0",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "vitest": "^3.2.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  },
  "sideEffects": false
}
