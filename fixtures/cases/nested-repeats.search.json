{
  "cases": [
    {
      "query": "line",
      "options": { "caseSensitive": false, "wholeWord": false, "regex": false },
      "scope": "document",
      "target": "names",
      "expected": [
        {
          "path": "0/0/1",
          "target": "name",
          "attr": null,
          "ranges": [[0, 4]]
        },
        {
          "path": "0/0/2",
          "target": "name",
          "attr": null,
          "ranges": [[0, 4]]
        },
        {
          "path": "0/1/1",
          "target": "name",
          "attr": null,
          "ranges": [[0, 4]]
        }
      ]
    },
    {
      "query": "line",
      "options": { "caseSensitive": false, "wholeWord": false, "regex": false },
      "scope": "grid",
      "target": "all",
      "grid": { "path": "0", "group": "order" },
      "expected": [
        {
          "row": 0,
          "column": "line",
          "ranges": [[0, 4]]
        },
        {
          "row": 1,
          "column": "line",
          "ranges": [[0, 4]]
        }
      ]
    },
    {
      "query": "Ann",
      "options": { "caseSensitive": false, "wholeWord": false, "regex": false },
      "scope": "grid",
      "target": "all",
      "grid": { "path": "0", "group": "order" },
      "expected": [
        {
          "row": 0,
          "column": "customer",
          "ranges": [[0, 3]]
        }
      ]
    },
    {
      "query": "1\\.00|2\\.50",
      "options": { "caseSensitive": false, "wholeWord": false, "regex": true },
      "scope": "document",
      "target": "all",
      "expected": [
        {
          "path": "0/0/1/0",
          "target": "text",
          "attr": null,
          "ranges": [[0, 4]]
        },
        {
          "path": "0/0/2/0",
          "target": "text",
          "attr": null,
          "ranges": [[0, 4]]
        }
      ]
    }
  ],
  "xpath": [
    {
      "expr": "//order[line/@sku='Y']",
      "expected": {
        "nodes": [{ "path": "0/0", "kind": "element", "attr": null }]
      }
    },
    {
      "expr": "//line[discount]/price",
      "expected": {
        "nodes": [{ "path": "0/1/1/0", "kind": "element", "attr": null }]
      }
    },
    {
      "expr": "sum(//line/@qty)",
      "expected": { "scalar": 8 }
    }
  ]
}
